{
  "name": "cv-legivel",
  "version": "2.0.0",
  "private": true,
  "description": "Gerador de currículo em PDF legível por ATS, 100% no navegador.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "http-server . -p 8000 -c-1 -o",
    "lint": "eslint . && html-validate index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "http-server": "14.1.1",
    "prettier": "3.9.10"
  }
}
